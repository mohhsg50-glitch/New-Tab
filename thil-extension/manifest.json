{
  "manifest_version": 3,
  "name": "Thil - ضاغط الصور ولوحة التحكم",
  "version": "2.0",
  "description": "ضغط الصور بجودة عالية + لوحة تحكم متكاملة للمتصفح",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Thil - ضغط الصور",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
